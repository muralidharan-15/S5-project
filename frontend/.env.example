# Backend API URL for Mobile / Production
# For Android Emulator, default is http://10.0.2.2:8000
# For Physical Android / iOS phone on the same Wi-Fi network, set your PC's local IP:
# VITE_API_BASE_URL=http://192.168.1.100:8000
# For Cloud Production backend:
# VITE_API_BASE_URL=https://your-api-domain.com
VITE_API_BASE_URL=http://10.0.2.2:8000
